<% layout("/layouts/boilerplate") %>
<!-- <h3>All Listings</h3> -->

<style>
  #filters{
    display:flex;
    flex-wrap:nowrap;
    align-items:flex-start;
    gap:1.25rem;
    overflow-x:auto;
    padding:0.25rem 0 0.5rem;
    scrollbar-width:thin;
  }
  .filter{
    flex:0 0 auto;
    text-align: center;
    margin-top: 2rem;
    opacity:0.7;
  }
  .filter:hover{
    opacity:1;
    cursor:pointer;
  }
  .filter p{
    font-size: 0.8rem;
  }
  .tax-toggle{
    display:flex;
    align-items:center;
    margin-left:auto;
    flex:0 0 auto;
    margin-top:2rem;
    padding:0.55rem 0.8rem;
    border:1px solid #dee2e6;
    border-radius:0.75rem;
    white-space:nowrap;
    height: 3.25rem;
  }
  .tax-toggle .form-check{
    margin:0;
  }
  @media (max-width: 768px){
    .tax-toggle{
      margin-left:1rem;
      margin-top:2rem;
    }
    .tax-toggle .form-check-label{
      font-size:0.9rem;
    }
  }
  .tax-info{
    display: none;
  }
</style>
 <div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
    <div class="filter">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>
    <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </div>
    <div class="filter">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
  </div>
   <div class="filter">
    <div><i class="fa-solid fa-ship"></i></div>
    <p>Boats</p>
  </div>
  <div class="tax-toggle">
  <div class="form-check form-check-reverse form-switch">
  <input class="form-check-input"
   type="checkbox" 
   role="switch" 
   id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
</div>
  </div>
 </div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-3">
  <% for (let listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-links">
        <div class="card listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top listing-img" alt="listing_image" />
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br />
              &#8377; <span class="listing-price" data-price="<%= listing.price %>"><%= listing.price.toLocaleString("en-IN") %></span> / night
              <i class="tax-info">&nbsp;+18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<script>
  const taxSwitch = document.getElementById('flexSwitchCheckDefault');
  const taxRate = 0.18;

  taxSwitch.addEventListener('change', () => {
    document.querySelectorAll('.listing-price').forEach(priceElement => {
      const basePrice = Number(priceElement.dataset.price);
      const displayedPrice = taxSwitch.checked ? basePrice * (1 + taxRate) : basePrice;
      priceElement.textContent = displayedPrice.toLocaleString('en-IN', {
        maximumFractionDigits: 0
      });
    });
    document.querySelectorAll('.tax-info').forEach(taxInfo => {
      taxInfo.style.display = taxSwitch.checked ? 'inline' : 'none';
    });
  });
</script>