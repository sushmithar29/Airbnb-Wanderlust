<% layout('layouts/boilerplate') %>
<div class="listing-details">
  <div>
    <h3><%= listing.title %></h3>
  </div>
<div class="card show-card listing-card">
    <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=800&q=80' %>" class="card-img-top show-img" alt="listing_image">
   <div class="card-img-overlay"></div>
   <div class="card-body">
     <p class="card-text">Owned by
       <i><%= listing.owner?.username || "Unknown" %></i></p>
     <p class="card-text"><%= listing.description %></p>
     <p class="card-text">&#8377;<%= listing.price?.toLocaleString("en-IN") || "N/A" %></p>
     <p class="card-text"><%= listing.location %></p>
     <p class="card-text"><%= listing.country %></p>
    </div>
  </div>
  </div>
   <br />
   
<div class="btns">
  <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark edit-btn" title="Only the listing owner can edit this listing">Edit</a>
  <form method="POST" action="/listings/<%= listing.id %>?_method=DELETE">
    <button type="submit" class="btn btn-dark" title="Only the listing owner can delete this listing">Delete</button>
  </form>
</div>

<div class="col-6 offset-3 mb-4">
  <hr>
  <h4>Where you'll be</h4>
  <% if (listing.geometry?.coordinates?.length === 2) { %>
    <div
      id="map"
      data-coordinates='<%= JSON.stringify(listing.geometry.coordinates) %>'
      data-title="<%= listing.title %>"
    ></div>
    <script src="/js/map.js"></script>
  <% } else { %>
    <p class="text-muted">Map coordinates are not available for this listing yet.</p>
  <% } %>
</div>



<div  class = "col-8
   offset-3">
   <hr />
   <% if(locals.isLoggedIn) { %>
  <h4> Leave a Review</h4>
  <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
      <!-- The range input has been replaced by the star selector. -->
      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>



      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
        <div class="invalid-feedback">Please add some comments for review.</div>
      </div>
      <button  class="btn btn-outline-dark">Submit</button>
  </form>
  
  <hr />
  <% } else { %>
  <h4>Leave a Review</h4>
  <p class="text-muted">Log in to rate this stay and share your experience.</p>
  <a class="btn add-btn mb-3" href="/login">Add a review</a>
  <hr />
  <% } %>


  <p><b>All Reviews</b> </p>
  <div class="row">

<% for (const review of listing.reviews) { %>
  <div class="card col-5 ms-3 mb-3">
<div class="card-body">
<h5 class="card-title">@<%= review.author?.username || "Anonymous" %></h5>
<p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
<p class="card-text"><%= review.comment %></p>

 
</div>
<form class="mb-3 mt-3" method="POST" action="/listings/<%= listing.id %>/reviews/<%= review._id %>?_method=DELETE">
  <button class="btn btn-sm btn-dark">Delete</button>
</form>

  </div>
<% } %>
</div>
</div>
</div>
