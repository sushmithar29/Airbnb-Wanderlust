<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-12 col-lg-8 mx-auto">

    <h3 class="show-title"><%= listing.title %></h3>

    <div class="card show-card listing-card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top show-img"
        alt="listing_image"
      />
    </div>

    <div class="mt-3">
      <p class="card-text owned-by">
        Owned by <i><%= listing.owner ? listing.owner.username : "Wanderlust host" %></i>
      </p>

      <p class="card-text description-text">
        <%= listing.description %>
      </p>

      <p class="card-text price-text">
        &#8377;<%= listing.price.toLocaleString("en-IN") %>
      </p>

      <p class="card-text"><%= listing.location %></p>

      <p class="card-text"><%= listing.country %></p>
    </div>


    <% if(currentUser) { %>

      <div class="btns mb-4">

        <a
          href="/listings/<%= listing._id %>/edit"
          class="btn btn-danger edit-btn"
        >
          Edit
        </a>

        <form
          method="POST"
          action="/listings/<%= listing._id %>?_method=DELETE"
          class="delete-form"
        >
          <button class="btn btn-dark">
            Delete
          </button>
        </form>

      </div>

    <% } %>


    <hr />


    <!-- REVIEW FORM -->

    <div class="mb-3">

      <% if(currentUser) { %>

        <h4>Leave a Review</h4>

        <form
          action="/listings/<%= listing._id %>/reviews"
          method="POST"
          noValidate
          autocomplete="off"
          class="needs-validation review-form"
        >

          <div class="mb-3 mt-3">

            <label class="form-label" for="rate1">
              Rating
            </label>

            <fieldset class="starability-slot">

              <input
                type="radio"
                id="rate1"
                name="review[rating]"
                value="1"
              />
              <label
                for="rate1"
                title="1 star"
                aria-label="1 star"
              ></label>


              <input
                type="radio"
                id="rate2"
                name="review[rating]"
                value="2"
              />
              <label
                for="rate2"
                title="2 stars"
                aria-label="2 stars"
              ></label>


              <input
                type="radio"
                id="rate3"
                name="review[rating]"
                value="3"
              />
              <label
                for="rate3"
                title="3 stars"
                aria-label="3 stars"
              ></label>


              <input
                type="radio"
                id="rate4"
                name="review[rating]"
                value="4"
              />
              <label
                for="rate4"
                title="4 stars"
                aria-label="4 stars"
              ></label>


              <input
                type="radio"
                id="rate5"
                name="review[rating]"
                value="5"
              />
              <label
                for="rate5"
                title="5 stars"
                aria-label="5 stars"
              ></label>

            </fieldset>

          </div>


          <div class="mb-3 mt-3">

            <label
              for="comment"
              class="form-label"
            >
              Comments
            </label>

            <textarea
              id="comment"
              name="review[comment]"
              cols="30"
              rows="5"
              class="form-control"
              required
            ></textarea>

            <div class="invalid-feedback">
              Please add some comments for review.
            </div>

          </div>


          <button class="btn btn-outline-dark">
            Submit
          </button>

        </form>

      <% } %>

    </div>


    <!-- ALL REVIEWS -->

    <% if (listing.reviews && listing.reviews.length > 0) { %>

      <h4>All Reviews</h4>

      <div class="reviews-grid">

        <% for (let review of listing.reviews) { %>

          <div class="review-card">

            <h5 class="review-user">
              @<%= review.author ? review.author.username : "Anonymous" %>
            </h5>


            <p
              class="starability-result card-text"
              data-rating="<%= review.rating %>"
            ></p>


            <p class="review-text">
              <%= review.comment %>
            </p>


            <form
              class="mb-3"
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
            >

              <button class="btn btn-dark review-delete-btn">
                Delete
              </button>

            </form>

          </div>

        <% } %>

      </div>

    <% } %>


    <!-- MAP -->

    <div class="mb-3">

      <h3>Where you'll be</h3>

      <div
        id="map"
        data-map-token="<%= typeof mapToken !== 'undefined' ? mapToken : '' %>"
        data-coordinates="<%= typeof coordinates !== 'undefined' && coordinates.length ? coordinates.join(',') : '' %>"
        data-title="<%= listing.title %>"
        data-location="<%= listing.location %>"
        data-country="<%= listing.country %>"
      ></div>

    </div>

  </div>
</div>